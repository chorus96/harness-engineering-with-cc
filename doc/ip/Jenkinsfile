// Jenkinsfile — IEEE 1500 HBM PMBIST 컨트롤러 하네스 CI (온프레미스 참조 예시)
// 온프레미스 Bitbucket Data Center + 사내 Jenkins 조합.
// - PR 게이트: run-lint/run-sim의 mock(툴 불필요)로 빠르게.
// - 보호 브랜치/야간: EDA 라이선스에 접근 가능한 사내 에이전트에서 live 실행.
// - 결과는 Bitbucket Build Status/Code Insights로 되돌려 표시(플러그인/REST).
// 실제 에이전트 라벨·자격증명·Bitbucket 연동 방식은 사내 환경에 맞춰 채운다.
pipeline {
  agent none
  options { timestamps() }

  stages {
    stage('Lint & Sim (mock)') {
      // PR 및 일반 브랜치: 공용 빌드 에이전트에서 빠른 게이트
      agent { label 'linux' }
      steps {
        sh 'bash .claude/skills/run-lint/bin/run.sh rtl run/lint.json'
        sh 'bash .claude/skills/run-sim/bin/run.sh  tb  run/sim.json'
        sh 'cat run/lint.json run/sim.json'
      }
      post { always { archiveArtifacts artifacts: 'run/*.json', allowEmptyArchive: true } }
    }

    stage('EDA live (self-hosted)') {
      // 보호 브랜치에서만: EDA 라이선스·컴퓨팅 보유 사내 에이전트
      when { branch 'main' }
      agent { label 'eda-vivado' }   // 사내 EDA 러너 라벨(예시)
      environment { USE_LIVE_TOOLS = '1' }
      steps {
        sh 'bash .claude/skills/run-lint/bin/run.sh rtl run/lint.json'
        sh 'bash .claude/skills/run-sim/bin/run.sh  tb  run/sim.json'
      }
      post {
        always {
          archiveArtifacts artifacts: 'run/lint.json, run/lint.log, run/sim.json, run/sim_work/**', allowEmptyArchive: true
          // 예시: Bitbucket Code Insights로 rtl-review-team 리포트/린트 결과를 PR에 게시
          // sh 'python3 tools/post_code_insights.py run/lint.json run/sim.json'
        }
      }
    }
  }

  post {
    // Jenkins → Bitbucket Data Center 빌드 상태 전송(플러그인 사용 시 자동).
    success { echo 'CI PASS — Bitbucket 필수 빌드 통과' }
    failure { echo 'CI FAIL — PR 병합 게이트 차단' }
  }
}

// 주의:
// - 최종 사인오프는 CI 통과가 아니라 Bitbucket "필수 승인(required approvers)"으로 사람이 결정한다.
// - 하네스는 리뷰 리포트를 PR 코멘트/Code Insights로만 게시하고 자동 병합/자동 승인하지 않는다.
// - Bitbucket Pipelines(bitbucket-pipelines.yml)는 클라우드 전용이라 Data Center에서는 사용하지 않는다.
